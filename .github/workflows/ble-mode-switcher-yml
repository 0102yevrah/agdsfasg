name: Build BLE Mode Switcher FAP

on:
  push:
  pull_request:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-24.04
    steps:
      - name: Check out firmware and submodules
        uses: actions/checkout@v4

      - name: Build FAP with uFBT
        id: build-app
        uses: flipperdevices/flipperzero-ufbt-action@v0.1
        with:
          app-dir: applications_user/ble_mode_switcher
          sdk-channel: release

      - name: Upload FAP artifact
        uses: actions/upload-artifact@v4
        with:
          name: ble-mode-switcher-${{ steps.build-app.outputs.suffix }}
          path: ${{ steps.build-app.outputs.fap-artifacts }}
